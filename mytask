#!/usr/bin/env python3
"""mytask - simple sequential local task scheduler.

Usage:
  mytask <script.sh> [args...] [GPU_COUNT] [-m "desc"]   submit a task (optional description)
  mytask run <script.sh> [args...] [-m "desc"]  run NOW, bypassing the queue
                                    (starts immediately in parallel with
                                    whatever else is queued/running)
  mytask show [-d N|all] [-D DATE] [-w]  list tasks (default: last 24h; -d N: last N*24h;
                                    -D 260603 or YYYY-MM-DD: tasks started that day;
                                    -w/--full: don't truncate DESC/CMD)
  mytask info <id>               show full info of a task (untruncated)
  mytask log <id>                print task log
  mytask kill <id|a-b>           cancel/kill a task or an inclusive id range
  mytask parallel [N]            show/set parallelism (local total, worker per GPU)
  mytask workers [off|auto|ID...] show/set GPU worker dispatch
  mytask off [ID[,ID]...]        disable workers for automatic assignment
  mytask on ID[,ID]...           re-enable disabled workers
  mytask trust-workers [off|ID...] show/set workers allowed when probe fails
  mytask worker-ssh [ID TARGET|off ID] show/set SSH launch target for a worker
  mytask gpus [--detail] [ID...] list GPUs by worker
  mytask gpu-tasks [ID...]       list running task ids by GPU
  mytask gpu-policy [UTIL FREE]  show/set idle GPU thresholds
  mytask clear                   remove finished tasks from list (keep logs)
  mytask stop-daemon             stop the background daemon
  mytask --daemon                (internal) run the scheduler loop
"""

