    except Exception as exc:
        return {"worker_id": str(worker_id), "ok": False, "error": str(exc)}
    result = {"worker_id": str(worker_id), "ok": False, "raw": out.stdout.strip()}
    for line in out.stdout.splitlines():
        if line.startswith("MYTASK_GPU_PROBE_JSON="):
            try:
                result.update(json.loads(line.split("=", 1)[1]))
            except json.JSONDecodeError as exc:
                result["error"] = f"invalid probe json: {exc}"
            break
    if out.returncode != 0:
        result["ok"] = False
        result["error"] = result.get("error") or f"mlx worker login exit={out.returncode}"
    return result


def gpu_free_percent(info):
    used = _parse_smi_int(info.get("memory_used_mib"))
    total = _parse_smi_int(info.get("memory_total_mib"))
    if total is None or total <= 0 or used is None:
        return None
    return (total - used) * 100.0 / total


def gpu_is_idle(gpu, cfg):
    util = _parse_smi_int(gpu.get("gpu_util"))
    free_pct = gpu_free_percent(gpu)
    if free_pct is None:
        return False
    if util is None:
        return free_pct > cfg["gpu_free_min"]
    return util < cfg["gpu_util_max"] and free_pct > cfg["gpu_free_min"]


def gpu_slot_id(worker_id, gpu_index):
    return f"{worker_id}:{gpu_index}"


def task_gpu_slots(task):
    slots = task.get("gpu_slots")
    if slots:
        return [str(slot) for slot in slots if slot]
    slot = task.get("gpu_slot")
    if slot:
        return [str(slot)]
    if task.get("worker_id") and task.get("gpu_index") is not None:
        return [gpu_slot_id(task.get("worker_id"), task.get("gpu_index"))]
    return []


def gpu_preference_rank(gpu):
    name = str(gpu.get("gpu_name") or "").upper()
    if "H100" in name:
        return 0
    if "A100" in name:
        return 2
    return 1


def trusted_worker_gpu_info(worker_id, cfg, inventory=None):
    worker_id = str(worker_id)
    if worker_id not in set(cfg.get("trusted_workers") or []):
        return None
    if inventory is None:
        inventory = worker_inventory()
    inv = inventory.get(worker_id, {})
    gpu_count = int(inv.get("gpu_count") or 0)
    if gpu_count <= 0:
        return None
    gpu_type = inv.get("gpu_type") or "trusted-gpu"
    return {
        "ok": True,
        "worker_id": worker_id,
        "hostname": None,
        "probe_source": "trusted",
        "trusted": True,
        "gpus": [
            {
                "gpu_index": str(idx),
                "gpu_uuid": None,
                "gpu_name": gpu_type,
                "memory_used_mib": 0,
                "memory_total_mib": 100,
                "memory_free_mib": 100,
                "gpu_util": None,
                "probe_source": "trusted",
                "trusted": True,
            }
            for idx in range(gpu_count)
        ],
    }


def select_worker_gpus(cfg, busy_slots=(), gpu_count=1):
    gpu_count = max(1, int(gpu_count or 1))
    busy_counts = {}
    for slot in busy_slots:
        if slot:
            busy_counts[str(slot)] = busy_counts.get(str(slot), 0) + 1
    per_gpu_limit = cfg["parallel"]
    inventory = worker_inventory()
    candidates = []
    workers = list(configured_workers(cfg))
    # Probe all workers concurrently: each probe is an independent blocking SSH
    # round-trip, so a thread pool turns the wall-clock cost from a sum into a
    # max. The candidate list is still built in the original worker order below
    # so selection (min over rank/worker_pos/gpu_pos) is unchanged.
    probed = {}
    if workers:
        with ThreadPoolExecutor(max_workers=len(workers)) as pool:
            for worker_id, info in zip(
                workers, pool.map(lambda w: probe_worker_gpu(w, cfg), workers)
            ):
                probed[worker_id] = info
    for worker_pos, worker_id in enumerate(workers):
        info = probed.get(worker_id) or {}
        if not info.get("ok"):
            info = trusted_worker_gpu_info(worker_id, cfg, inventory=inventory)
            if not info:
                continue
        worker_gpus = []
        for gpu_pos, gpu in enumerate(info.get("gpus") or []):
            slot = gpu_slot_id(worker_id, gpu.get("gpu_index"))
            if busy_counts.get(slot, 0) >= per_gpu_limit:
                continue
            if gpu_is_idle(gpu, cfg):
                worker_gpus.append((gpu_preference_rank(gpu), gpu_pos, gpu))
        if len(worker_gpus) >= gpu_count:
            worker_gpus = sorted(worker_gpus, key=lambda x: x[:2])[:gpu_count]
            rank = max(x[0] for x in worker_gpus)
            first_gpu_pos = min(x[1] for x in worker_gpus)
            candidates.append((rank, worker_pos, first_gpu_pos, str(worker_id), info, [x[2] for x in worker_gpus]))
    if candidates:
        _rank, _worker_pos, _gpu_pos, worker_id, info, gpus = min(candidates, key=lambda x: x[:3])
        return worker_id, info, gpus
    return None, None, []


def select_worker_gpu(cfg, busy_slots=()):
    worker_id, info, gpus = select_worker_gpus(cfg, busy_slots=busy_slots, gpu_count=1)
    return worker_id, info, gpus[0] if gpus else None


def build_launch_command(task, cfg, busy_slots=()):
    if not cfg.get("worker_dispatch"):
        return task["cmd"], None
    requested_gpu_count = max(1, int(task.get("gpu_count") or 1))
    worker_id, info, gpus = select_worker_gpus(
        cfg, busy_slots=busy_slots, gpu_count=requested_gpu_count
    )
    if not worker_id:
        return None, None
    cmd = " ".join(shlex.quote(c) for c in task["cmd"])
    # Always cd into the task's submission cwd on the remote worker. The paths
    # live on a shared filesystem, so the submit-side path is valid on the
    # worker too. Do NOT gate this on a local os.path.isdir() check: when that
    # returned False the cd was dropped and the script ran from the SSH login
    # dir (/home/tiger), breaking relative paths like main.py / ../data.
    cwd = shlex.quote(task["cwd"]) if task.get("cwd") else None
    gpu_indices = [str(gpu.get("gpu_index")) for gpu in gpus]
    gpu_visible = ",".join(gpu_indices)
    remote_cmd = (
        f"export CUDA_VISIBLE_DEVICES={shlex.quote(gpu_visible)}; "
        f"export MYTASK_GPU_COUNT={shlex.quote(str(requested_gpu_count))}; "
        f"exec {cmd}"
    )
    remote = f"cd {cwd} && {remote_cmd}" if cwd else remote_cmd
    # All workers are dispatched over SSH. The target is taken from worker_ssh
    # if set, otherwise derived from the worker id.
    ssh_target = resolve_ssh_target(worker_id, cfg)
    launcher = "ssh"
    launch_cmd = _ssh_remote_bash_argv(ssh_target, remote)
    gpu_free_values = [gpu_free_percent(gpu) for gpu in gpus]
    gpu_free_values = [x for x in gpu_free_values if x is not None]
    min_gpu_free = min(gpu_free_values) if gpu_free_values else None
    return launch_cmd, {
        "worker_id": worker_id,
        "worker_host": info.get("hostname"),
        "gpu_index": gpu_visible,
        "gpu_indices": gpu_indices,
        "gpu_slot": gpu_slot_id(worker_id, gpu_indices[0]) if gpu_indices else None,
        "gpu_slots": [gpu_slot_id(worker_id, idx) for idx in gpu_indices],
        "gpu_uuid": ",".join(str(gpu.get("gpu_uuid") or "-") for gpu in gpus),
        "gpu_name": ",".join(str(gpu.get("gpu_name") or "-") for gpu in gpus),
        "gpu_util": ",".join(str(gpu.get("gpu_util")) for gpu in gpus),
        "gpu_free_percent": min_gpu_free,
        "gpu_count": requested_gpu_count,
        "launcher": launcher,
        "ssh_target": ssh_target,
    }


# ---------- commands ----------

def display_cmd(t):
    """Command to show the user: original submitted script path, not the cached copy."""
    dc = t.get("display_cmd")
    if dc:
        return dc
    # Fallback for tasks submitted before display_cmd existed: swap the cached
    # script (cmd[1]) back to the original script path; args kept as stored.
    c = t.get("cmd")
    if c and len(c) >= 2 and t.get("script"):
        return [c[0], t["script"], *c[2:]]
    return c or [t.get("script", "")]


def _prepare_submission(argv, mode):
    """Parse argv (script + args + optional -m/--desc), snapshot yaml/dataset
    refs, and append a new task record with the given `mode` ("queued" for
    the normal daemon-served queue, "immediate" for `mytask run`).

    Returns (tid, task, script_path, extra, cached_yamls, ds_state).
    """
    desc = ""
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-m", "--desc") and i + 1 < len(argv):
            desc = argv[i + 1]
            i += 2
            continue
        if a.startswith("-m="):
            desc = a[3:]
            i += 1
            continue
        if a.startswith("--desc="):
            desc = a[7:]
            i += 1
            continue
        rest.append(a)
        i += 1
    if not rest:
        print("mytask: missing script", file=sys.stderr)
        sys.exit(1)
    script = rest[0]
    script_path = Path(script).expanduser()
    if not script_path.exists():
        print(f"mytask: {script}: no such file", file=sys.stderr)
        sys.exit(1)
    script_path = script_path.resolve()
    extra = rest[1:]
    gpu_count = 1
    if mode == "queued" and extra and re.fullmatch(r"[1-9]\d*", extra[-1]):
        gpu_count = int(extra[-1])
        extra = extra[:-1]
    today = datetime.now().strftime("%Y-%m-%d")
    day_dir = LOGS_DIR / today
    day_dir.mkdir(parents=True, exist_ok=True)
    init()
    with locked():
        tasks = load_tasks()
        tid = next_id(tasks)
        cwd = os.getcwd()
        tdir = task_cache_dir(tid)
        tdir.mkdir(parents=True, exist_ok=True)
        cached = tdir / f"{tid}{script_path.suffix or '.sh'}"
        shutil.copy2(script_path, cached)
        new_extra, cached_yamls = snapshot_yamls(extra, tdir)
        # Also rewrite literal yaml paths embedded inside the (cached) script.
        script_yamls = snapshot_yamls_in_script(cached, script_cwd=cwd, dest_dir=tdir)
        if script_yamls:
            cached_yamls = list(cached_yamls) + script_yamls
        # Freeze the --dataset_version module (args + script) so later edits to
        # data/<name>.py don't change a queued/running task.
        ds_state = {"modules": [], "archives": [], "seen": {}}
        new_extra = snapshot_dataset_in_args(new_extra, tid, cwd, tdir, ds_state)
        snapshot_dataset_in_script(cached, tid, cwd, tdir, ds_state)
        cmd = ["bash", str(cached), *new_extra]
        task = {
            "id": tid,
            "cmd": cmd,
            "display_cmd": ["bash", str(script_path), *extra],
            "gpu_count": gpu_count,
            "script": str(script_path),
            "cached_script": str(cached),
            "cached_yamls": cached_yamls,
            "cached_dataset_modules": ds_state["modules"],
            "cached_datasets": ds_state["archives"],
            "desc": desc,
            "cwd": cwd,
            "status": "pending",
            "mode": mode,
            "submitted_at": now_iso(),
            "started_at": None,
            "finished_at": None,
            "exit_code": None,
            "pid": None,
            "log": str(day_dir / f"{tid}.log"),
        }
        tasks.append(task)
        save_tasks(tasks)
    return tid, task, script_path, extra, cached_yamls, ds_state


def _submission_msg(verb, tid, script_path, extra, cached_yamls, ds_state, desc, gpu_count=1):
    msg = f"{verb} task {tid}: {script_path}"
    if extra:
        msg += " " + " ".join(shlex.quote(c) for c in extra)
    if gpu_count and int(gpu_count) > 1:
        msg += f"   [gpus={gpu_count}]"
    if cached_yamls:
        msg += f"   [snapshotted {len(cached_yamls)} yaml]"
    if ds_state["modules"]:
        msg += f"   [snapshotted {len(ds_state['modules'])} dataset]"
    if desc:
        msg += f"   # {desc}"
    return msg


def cmd_submit(argv):
    tid, task, script_path, extra, cached_yamls, ds_state = _prepare_submission(
        argv, mode="queued"
    )
    print(_submission_msg("submitted", tid, script_path, extra, cached_yamls, ds_state, task["desc"], task.get("gpu_count", 1)))
    ensure_daemon()


def cmd_run(argv):
    """Run a task right now, bypassing the daemon's serial queue: it starts
    immediately and can execute in parallel with whatever the daemon is
    already running."""
    tid, task, script_path, extra, cached_yamls, ds_state = _prepare_submission(
        argv, mode="immediate"
    )
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--run-one", str(tid)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    print(_submission_msg("running", tid, script_path, extra, cached_yamls, ds_state, task["desc"], task.get("gpu_count", 1))
          + "   [bypassing queue]")


def _parse_show_date(s):
    """Parse a date filter: YYMMDD (260603), YYMMDD_HHMMSS (260603_085554),
    YYYY-MM-DD, or YYYYMMDD. Only the date part is used."""
    s = s.strip().split("_", 1)[0]   # drop optional _HHMMSS time suffix
    for fmt in ("%y%m%d", "%Y-%m-%d", "%Y%m%d"):
        try:
            return datetime.strptime(s, fmt).date()
        except ValueError:
            continue
    return None


def cmd_show(argv):
    # parse -d N (or -d all) — rolling window in days, default 1 (last 24h)
    # parse -D <date> (YYMMDD / YYYY-MM-DD) — tasks that STARTED on that calendar day
    days = 1
    on_date = None
    full = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-w", "--full"):
            full = True
            i += 1
            continue
        if a == "-d" and i + 1 < len(argv):
            v = argv[i + 1]
            days = 0 if v == "all" else int(v)
            i += 2
            continue
        if a.startswith("-d="):
            v = a[3:]
            days = 0 if v == "all" else int(v)
            i += 1
            continue
        if a == "-D" and i + 1 < len(argv):
            on_date = _parse_show_date(argv[i + 1])
            if on_date is None:
                print(f"mytask: invalid -D date '{argv[i+1]}' (use YYMMDD, YYMMDD_HHMMSS or YYYY-MM-DD)", file=sys.stderr)
                sys.exit(1)
            i += 2
            continue
        if a.startswith("-D="):
            v = a[3:]
            on_date = _parse_show_date(v)
            if on_date is None:
                print(f"mytask: invalid -D date '{v}' (use YYMMDD, YYMMDD_HHMMSS or YYYY-MM-DD)", file=sys.stderr)
                sys.exit(1)
            i += 1
            continue
        i += 1

    tasks = load_tasks()
    if not tasks:
        print("(no tasks)")
        return

    # -D <date>: show tasks that STARTED on that calendar day (overrides -d window)
    if on_date is not None:
        def started_on(t):
            v = t.get("started_at")
            if not v:
                return False
            dt = parse_task_datetime(v)
            return dt is not None and dt.date() == on_date
        tasks = [t for t in tasks if started_on(t)]
        daemon_status = "running" if daemon_alive() else "stopped"
        cfg = load_config()
        worker_mode = "on" if cfg.get("worker_dispatch") else "off"
        print(f"daemon: {daemon_status}   parallel: {parallel_summary(cfg)}   workers: {worker_mode}   showing: started on {on_date.isoformat()}   tasks: {len(tasks)}")
        _print_task_table(tasks, full=full)
        return

    # filter by submitted_at, rolling window of `days`*24h from now
    if days > 0:
        cutoff = datetime.now(BEIJING_TZ) - timedelta(days=days)
        def in_range(t):
            # always show pending/running regardless of time
            if t["status"] in ("pending", "running"):
                return True
            dt = parse_task_datetime(t.get("submitted_at"))
            if dt is None:
                return True
            return dt >= cutoff
        tasks = [t for t in tasks if in_range(t)]

    daemon_status = "running" if daemon_alive() else "stopped"
    cfg = load_config()
    worker_mode = "on" if cfg.get("worker_dispatch") else "off"
    print(f"daemon: {daemon_status}   parallel: {parallel_summary(cfg)}   workers: {worker_mode}   showing: {'all' if days == 0 else f'last {days}x24h'}   tasks: {len(tasks)}")
    _print_task_table(tasks, full=full)


def _print_task_table(tasks, full=False):
    if not tasks:
        return
    fmt = "{:>4}  {:<10}  {:<19}  {:<19}  {:>5}  {:<20}  {}"
    print(fmt.format("ID", "STATUS", "STARTED(BJ)", "FINISHED(BJ)", "EXIT", "DESC", "CMD"))
    for t in tasks:
        cmd = " ".join(shlex.quote(c) for c in display_cmd(t))
        if not full and len(cmd) > 60:
            cmd = cmd[:57] + "..."
        desc = t.get("desc") or "-"
        if not full and len(desc) > 20:
            desc = desc[:17] + "..."
        print(fmt.format(
            t["id"],
            t["status"],
            display_time(t.get("started_at")),
            display_time(t.get("finished_at")),
            "-" if t["exit_code"] is None else str(t["exit_code"]),
            desc,
            cmd,
        ))


