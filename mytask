def load_config():
    try:
        cfg = json.loads(CONFIG_FILE.read_text() or "{}")
    except (FileNotFoundError, json.JSONDecodeError):
        cfg = {}
    parallel = int(cfg.get("parallel", 1) or 1)
    workers = cfg.get("workers") or []
    if isinstance(workers, str):
        workers = [w for w in re.split(r"[,\s]+", workers.strip()) if w]
    trusted_workers = cfg.get("trusted_workers") or []
    if isinstance(trusted_workers, str):
        trusted_workers = [w for w in re.split(r"[,\s]+", trusted_workers.strip()) if w]
    disabled_workers = cfg.get("disabled_workers") or []
    if isinstance(disabled_workers, str):
        disabled_workers = [w for w in re.split(r"[,\s]+", disabled_workers.strip()) if w]
    worker_ssh = cfg.get("worker_ssh") or {}
    if not isinstance(worker_ssh, dict):
        worker_ssh = {}
    worker_dispatch = bool(cfg.get("worker_dispatch", False))
    worker_auto_discover = bool(cfg.get("worker_auto_discover", False))
    gpu_util_max = int(cfg.get("gpu_util_max", DEFAULT_GPU_UTIL_MAX))
    gpu_free_min = int(cfg.get("gpu_free_min", DEFAULT_GPU_FREE_MIN))
    return {
        "parallel": max(1, parallel),
        "worker_dispatch": worker_dispatch,
        "worker_auto_discover": worker_auto_discover,
        "workers": [str(w) for w in workers],
        "trusted_workers": [str(w) for w in trusted_workers],
        "disabled_workers": [str(w) for w in disabled_workers],
        "worker_ssh": {str(k): str(v) for k, v in worker_ssh.items() if v},
        "worker_ssh_user": str(cfg.get("worker_ssh_user") or DEFAULT_WORKER_SSH_USER),
        "worker_ssh_host": str(cfg.get("worker_ssh_host") or DEFAULT_WORKER_SSH_HOST),
        "gpu_util_max": gpu_util_max,
        "gpu_free_min": gpu_free_min,
    }


def save_config(cfg):
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))


def now_iso():
    return datetime.now(BEIJING_TZ).isoformat(timespec="seconds")


def parse_task_datetime(value):
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value))
    except Exception:
        return None
    if dt.tzinfo is None:
        # Older records were written on this UTC host without timezone info.
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(BEIJING_TZ)


def display_time(value):
    dt = parse_task_datetime(value)
    if dt is None:
        return "-"
    return dt.strftime("%Y-%m-%dT%H:%M:%S")


def parallel_summary(cfg):
    if cfg.get("worker_dispatch"):
        return f"{cfg['parallel']}/gpu total_slots=dynamic"
    return f"{cfg['parallel']} total"


def next_id(tasks):
    return max((t["id"] for t in tasks), default=0) + 1


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def reap_dead_running_tasks(tasks, managed_ids=()):
    managed_ids = set(managed_ids or ())
    changed = False
    for t in tasks:
        if t.get("status") != "running":
            continue
        if t.get("mode") == "immediate":
            continue
        if t.get("id") in managed_ids:
            continue
        if pid_alive(t.get("pid") or 0):
            continue
        t["status"] = "orphaned"
        t["finished_at"] = now_iso()
        t["exit_code"] = t.get("exit_code")
        changed = True
    return changed


def mlxc_available():
    return os.path.exists(MLXC_BIN) and os.access(MLXC_BIN, os.X_OK)


def discover_workers():
    return list(worker_inventory().keys())


def worker_inventory():
    if not mlxc_available():
        return {}
    try:
        out = subprocess.run(
            [MLXC_BIN, "worker", "list"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
        )
    except Exception:
        return {}
    inventory = {}
    for line in out.stdout.splitlines():
        parts = line.split()
        if parts and parts[0].isdigit():
            gpu_count = int(parts[3]) if len(parts) > 3 and parts[3].isdigit() else 0
            gpu_type = parts[4] if len(parts) > 4 else "-"
            inventory[parts[0]] = {"gpu_count": gpu_count, "gpu_type": gpu_type}
    return inventory


def configured_workers(cfg):
    workers = list(cfg.get("workers") or [])
    if cfg.get("worker_auto_discover"):
        for wid in discover_workers():
            if wid not in workers:
                workers.append(wid)
    disabled = set(cfg.get("disabled_workers") or [])
    return [str(w) for w in workers if str(w) not in disabled]


def _parse_smi_int(value):
    m = re.search(r"\d+", str(value))
    return int(m.group(0)) if m else None


def default_ssh_target(worker_id, cfg=None):
    """Derive the SSH login target for a worker from its id."""
    user = (cfg or {}).get("worker_ssh_user") or DEFAULT_WORKER_SSH_USER
    host = (cfg or {}).get("worker_ssh_host") or DEFAULT_WORKER_SSH_HOST
    return f"{worker_id}.{user}.worker@{host}"


def resolve_ssh_target(worker_id, cfg=None):
    """Return the SSH target for a worker.

    An explicit mapping in worker_ssh always wins; otherwise every worker
    defaults to the derived SSH address so all workers are dispatched over SSH.
    """
    cfg = cfg or {}
    explicit = (cfg.get("worker_ssh") or {}).get(str(worker_id))
    if explicit:
        return explicit
    return default_ssh_target(worker_id, cfg)


def _ssh_base_argv(ssh_target):
    return [
        "ssh",
        "-i",
        DEFAULT_WORKER_SSH_KEY,
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "ConnectTimeout=15",
        ssh_target,
    ]


def _ssh_remote_bash_argv(ssh_target, script):
    """Build an SSH argv that runs the whole script as one remote bash command."""
    return _ssh_base_argv(ssh_target) + [f"bash -lc {shlex.quote(script)}"]


# Python snippet run on a worker to report per-GPU state via torch (no nvidia-smi).
GPU_PROBE_CODE = r'''
import json
import os
import socket

info = {
    "ok": False,
    "hostname": socket.gethostname(),
    "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
    "nvidia_visible_devices": os.environ.get("NVIDIA_VISIBLE_DEVICES"),
    "probe_source": "torch",
    "gpus": [],
}
try:
    import torch

    info["torch_version"] = torch.__version__
    info["cuda_available"] = torch.cuda.is_available()
    info["device_count"] = torch.cuda.device_count()
    if info["cuda_available"]:
        for idx in range(info["device_count"]):
            props = torch.cuda.get_device_properties(idx)
            free_b, total_b = torch.cuda.mem_get_info(idx)
            used_b = total_b - free_b
            info["gpus"].append(
                {
                    "gpu_index": str(idx),
                    "gpu_uuid": None,
                    "gpu_name": props.name,
                    "gpu_capability": f"{props.major}.{props.minor}",
                    "memory_used_mib": int(used_b // 1024 // 1024),
                    "memory_total_mib": int(total_b // 1024 // 1024),
                    "memory_free_mib": int(free_b // 1024 // 1024),
                    "gpu_util": None,
                    "probe_source": "torch",
                }
            )
        info["ok"] = bool(info["gpus"])
    else:
        info["error"] = "torch cuda is not available"
except Exception as exc:
    info["error"] = f"{type(exc).__name__}: {exc}"

print("MYTASK_GPU_PROBE_JSON=" + json.dumps(info, sort_keys=True))
'''


def _parse_probe_output(worker_id, stdout, returncode, source):
    result = {"worker_id": str(worker_id), "ok": False, "raw": stdout.strip()}
    for line in stdout.splitlines():
        if line.startswith("MYTASK_GPU_PROBE_JSON="):
            try:
                result.update(json.loads(line.split("=", 1)[1]))
            except json.JSONDecodeError as exc:
                result["error"] = f"invalid probe json: {exc}"
            break
    if returncode != 0:
        result["ok"] = False
        result["error"] = result.get("error") or f"{source} exit={returncode}"
    return result


def probe_worker_gpu_ssh(worker_id, ssh_target):
    """Return per-GPU state for a worker via SSH + torch."""
    argv = _ssh_remote_bash_argv(ssh_target, f"/usr/bin/python -c {shlex.quote(GPU_PROBE_CODE)}")
    try:
        out = subprocess.run(
            argv,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=20,
        )
    except Exception as exc:
        return {"worker_id": str(worker_id), "ok": False, "error": str(exc)}
    return _parse_probe_output(worker_id, out.stdout, out.returncode, "ssh")


def probe_worker_gpu(worker_id, cfg=None):
    """Return per-GPU state for a worker.

    All workers are probed over SSH first. If SSH probing fails and mlxc is
    available, fall back to `mlxc worker login` (legacy path).
    """
    ssh_target = resolve_ssh_target(worker_id, cfg)
    if ssh_target:
        info = probe_worker_gpu_ssh(worker_id, ssh_target)
        if info.get("ok"):
            return info
    return probe_worker_gpu_mlxc(worker_id)


