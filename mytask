            tdir.rmdir()
        except OSError:
            pass


def _looks_like_yaml_path(s):
    return isinstance(s, str) and s.lower().endswith(YAML_EXTS)


def snapshot_yamls(extra, dest_dir):
    """Replace yaml-looking paths in `extra` with copies under `dest_dir`.

    Supports two forms:
      - bare path:           ".../foo.yaml"
      - key=path:            "--model_yaml=.../foo.yaml"
    Returns (new_extra, cached_paths).
    Files that don't exist on disk are left untouched.
    """
    new_extra = list(extra)
    cached_paths = []
    used = False

    def _cache(src_path):
        nonlocal used
        if not used:
            dest_dir.mkdir(parents=True, exist_ok=True)
            used = True
        # avoid name collisions across multiple yamls with same basename
        dst = dest_dir / src_path.name
        i = 1
        while dst.exists():
            dst = dest_dir / f"{src_path.stem}_{i}{src_path.suffix}"
            i += 1
        shutil.copy2(src_path, dst)
        cached_paths.append(str(dst))
        return str(dst)

    for i, a in enumerate(new_extra):
        if _looks_like_yaml_path(a):
            p = Path(a).expanduser()
            if p.is_file():
                new_extra[i] = _cache(p.resolve())
            continue
        if "=" in a:
            k, v = a.split("=", 1)
            if _looks_like_yaml_path(v):
                p = Path(v).expanduser()
                if p.is_file():
                    new_extra[i] = f"{k}={_cache(p.resolve())}"
    return new_extra, cached_paths


# Match yaml/yml paths inside a shell script. We accept bare tokens, single-
# or double-quoted strings, and key=value forms. The path itself can contain
# letters, digits, dot, slash, dash, underscore, tilde, and $ (for env vars
# we don't expand — only literal paths get rewritten).
_YAML_TOKEN = re.compile(
    r"""(?P<full>(?P<quote>["']?)(?P<path>[A-Za-z0-9_./~\-]+\.(?:yaml|yml))(?P=quote))""",
    re.IGNORECASE,
)


def snapshot_yamls_in_script(cached_script_path, script_cwd, dest_dir):
    """Scan a (cached) shell script, replace literal *.yaml/.yml paths with
    snapshot copies under `dest_dir`.

    Resolution order for each match:
      1. as-is (absolute, or relative to caller's cwd)
      2. relative to the original script directory

    Files that cannot be resolved are left untouched (assumed to be runtime-
    constructed paths, env vars, or user-provided args).

    Mutates the cached script in place. Returns cached_paths.
    """
    text = Path(cached_script_path).read_text(encoding="utf-8", errors="replace")
    cached_paths = []
    used = False
    seen = {}  # original_resolved_path -> cached_path

    def _cache(src_path):
        nonlocal used
        key = str(src_path)
        if key in seen:
            return seen[key]
        if not used:
            dest_dir.mkdir(parents=True, exist_ok=True)
            used = True
        dst = dest_dir / src_path.name
        i = 1
        while dst.exists():
            dst = dest_dir / f"{src_path.stem}_{i}{src_path.suffix}"
            i += 1
        shutil.copy2(src_path, dst)
        cached_paths.append(str(dst))
        seen[key] = str(dst)
        return str(dst)

    def _resolve(raw):
        # Skip paths with shell expansions we can't safely resolve.
        if "$" in raw or "`" in raw:
            return None
        candidates = []
        p = Path(raw).expanduser()
        if p.is_absolute():
            candidates.append(p)
        else:
            candidates.append(Path(script_cwd) / p)
            try:
                candidates.append(Path(cached_script_path).parent / p)
            except Exception:
                pass
        for c in candidates:
            try:
                if c.is_file():
                    return c.resolve()
            except OSError:
                continue
        return None

    def _sub(m):
        raw = m.group("path")
        quote = m.group("quote") or ""
        resolved = _resolve(raw)
        if resolved is None:
            return m.group(0)
        return f"{quote}{_cache(resolved)}{quote}"

    new_text = _YAML_TOKEN.sub(_sub, text)
    if new_text != text:
        Path(cached_script_path).write_text(new_text, encoding="utf-8")
    return cached_paths


# Match `--dataset_version <name>` / `--dataset_version=<name>`. The value is a
# bare python module name (letters, digits, underscore).
_DATASET_TOKEN = re.compile(r"(--dataset_version[ \t=]+)([A-Za-z_]\w*)")
_DATASET_NAME = re.compile(r"[A-Za-z_]\w*$")


def _dataset_src(name, script_cwd):
    """The training project resolves --dataset_version <name> via
    importlib.import_module(f"data.{name}"), i.e. <cwd>/data/<name>.py."""
    p = Path(script_cwd) / "data" / f"{name}.py"
    return p if p.is_file() else None


def _snapshot_one_dataset(name, tid, script_cwd, dest_dir, state):
    """Freeze data/<name>.py for this task. Returns the (possibly rewritten)
    module name to use. Memoized via `state` so the same name referenced in
    both args and the script maps to one snapshot.

    Creates two copies:
      - working module  <cwd>/data/<name>__mt<tid>.py   (runtime-effective,
        deleted when the task reaches a terminal state)
      - archival copy   <dest_dir>/<name>.py            (kept as a record)
    Names that can't be resolved on disk are left unchanged.
    """
    if name in state["seen"]:
        return state["seen"][name]
    src = _dataset_src(name, script_cwd)
    if src is None:
        state["seen"][name] = name
        return name
    src = src.resolve()
    new_name = f"{name}__mt{tid}"
    work = src.parent / f"{new_name}.py"
    shutil.copy2(src, work)
    state["modules"].append(str(work))
    dest_dir.mkdir(parents=True, exist_ok=True)
    arch = dest_dir / f"{name}.py"
    i = 1
    while arch.exists():
        arch = dest_dir / f"{name}_{i}.py"
        i += 1
    shutil.copy2(src, arch)
    state["archives"].append(str(arch))
    state["seen"][name] = new_name
    return new_name


def snapshot_dataset_in_args(extra, tid, script_cwd, dest_dir, state):
    """Rewrite --dataset_version values in the extra CLI args to frozen copies."""
    new_extra = list(extra)
    i = 0
    while i < len(new_extra):
        a = new_extra[i]
        if a == "--dataset_version" and i + 1 < len(new_extra):
            nm = new_extra[i + 1]
            if _DATASET_NAME.match(nm):
                new_extra[i + 1] = _snapshot_one_dataset(
                    nm, tid, script_cwd, dest_dir, state
                )
            i += 2
            continue
        if a.startswith("--dataset_version="):
            nm = a.split("=", 1)[1]
            if _DATASET_NAME.match(nm):
                new_extra[i] = "--dataset_version=" + _snapshot_one_dataset(
                    nm, tid, script_cwd, dest_dir, state
                )
        i += 1
    return new_extra


def snapshot_dataset_in_script(cached_script_path, tid, script_cwd, dest_dir, state):
    """Rewrite --dataset_version values embedded in the (cached) script."""
    text = Path(cached_script_path).read_text(encoding="utf-8", errors="replace")

    def _sub(m):
        return m.group(1) + _snapshot_one_dataset(
            m.group(2), tid, script_cwd, dest_dir, state
        )

    new_text = _DATASET_TOKEN.sub(_sub, text)
    if new_text != text:
        Path(cached_script_path).write_text(new_text, encoding="utf-8")


@contextmanager
def locked():
    init()
    f = open(LOCK_FILE, "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    try:
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


