def cmd_gpus(argv):
    detail = False
    workers_arg = []
    for arg in argv:
        if arg == "--detail":
            detail = True
        else:
            workers_arg.append(arg)
    inventory = worker_inventory()
    workers = workers_arg or list(inventory.keys())
    if not workers:
        print("mytask: no workers found; try `mytask workers auto` after workers are launched", file=sys.stderr)
        sys.exit(1)
    print("{:<12}  {}".format("WORKER", "GPU"))
    if not detail:
        for worker_id, gpu_index, gpu in iter_worker_gpu_rows(workers, inventory=inventory):
            gpu_type = gpu.get("gpu_name") or gpu.get("gpu_type") or "-"
            print("{:<12}  {}".format(str(worker_id), f"index={gpu_index} type={gpu_type}"))
        return
    for worker_id in workers:
        worker_id = str(worker_id)
        info = probe_worker_gpu(worker_id, load_config())
        if not info.get("ok"):
            trusted_info = trusted_worker_gpu_info(worker_id, load_config(), inventory=inventory)
            if trusted_info:
                for gpu in trusted_info.get("gpus") or []:
                    gpu_desc = (
                        f"index={gpu.get('gpu_index')} "
                        f"uuid={gpu.get('gpu_uuid')} "
                        f"name={gpu.get('gpu_name')} "
                        f"util=unknown "
                        f"free=trusted "
                        f"source=trusted"
                    )
                    print("{:<12}  {}".format(worker_id, gpu_desc))
                continue
            inv = inventory.get(worker_id, {})
            gpu_count = int(inv.get("gpu_count") or 0)
            gpu_type = inv.get("gpu_type") or "-"
            if gpu_count > 0:
                for idx in range(gpu_count):
                    print("{:<12}  {}".format(worker_id, f"index={idx} type={gpu_type} status=probe_unavailable"))
            else:
                err = info.get("error") or "probe failed"
                print("{:<12}  {}".format(worker_id, f"ERROR {err}"))
            continue
        for gpu in info.get("gpus") or []:
            free_pct = gpu_free_percent(gpu)
            free_s = "-" if free_pct is None else f"{free_pct:.1f}%"
            util = gpu.get("gpu_util")
            util_s = "unknown" if util is None else f"{util}%"
            gpu_desc = (
                f"index={gpu.get('gpu_index')} "
                f"uuid={gpu.get('gpu_uuid')} "
                f"name={gpu.get('gpu_name')} "
                f"util={util_s} "
                f"free={free_s} "
                f"source={gpu.get('probe_source') or info.get('probe_source') or '-'}"
            )
            print("{:<12}  {}".format(worker_id, gpu_desc))


def iter_worker_gpu_rows(workers, inventory=None):
    if inventory is None:
        inventory = worker_inventory()
    for worker_id in workers:
        worker_id = str(worker_id)
        inv = inventory.get(worker_id, {})
        gpu_count = int(inv.get("gpu_count") or 0)
        gpu_type = inv.get("gpu_type") or "-"
        for idx in range(gpu_count):
            yield worker_id, str(idx), {"gpu_index": str(idx), "gpu_name": gpu_type}


def cmd_gpu_tasks(argv):
    inventory = worker_inventory()
    workers = argv or list(inventory.keys())
    if not workers:
        print("mytask: no workers found; try `mytask workers auto` after workers are launched", file=sys.stderr)
        sys.exit(1)
    with locked():
        tasks = load_tasks()
    running_by_slot = {}
    for task in tasks:
        if task.get("status") != "running":
            continue
        if task.get("mode") != "immediate" and not pid_alive(task.get("pid") or 0):
            continue
        for slot in task_gpu_slots(task):
            running_by_slot.setdefault(slot, []).append(str(task.get("id")))
    print("{:<12}  {:<10}  {:<16}  {}".format("WORKER", "GPU", "GPU_TYPE", "RUNNING_TASKS"))
    seen_slots = set()
    for worker_id, gpu_index, gpu in iter_worker_gpu_rows(workers, inventory=inventory):
        slot = gpu_slot_id(worker_id, gpu_index)
        seen_slots.add(slot)
        task_ids = ",".join(running_by_slot.get(slot, [])) or "-"
        gpu_type = gpu.get("gpu_name") or gpu.get("gpu_type") or "-"
        print("{:<12}  {:<10}  {:<16}  {}".format(worker_id, gpu_index, gpu_type, task_ids))
    for slot in sorted(set(running_by_slot) - seen_slots):
        worker_id, _, gpu_index = slot.partition(":")
        task_ids = ",".join(running_by_slot[slot])
        print("{:<12}  {:<10}  {:<16}  {}".format(worker_id or "-", gpu_index or "-", "-", task_ids))


