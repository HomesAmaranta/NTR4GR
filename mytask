def run_one(tid):
    """Run a single 'immediate' task to completion in this process, updating
    tasks.json as it starts/finishes. Launched detached by `mytask run` so it
    survives the parent CLI invocation returning; runs independently of the
    daemon's serial loop, hence can overlap with a queued task."""
    init()
    tasks = load_tasks()
    t = next((x for x in tasks if x["id"] == tid), None)
    if t is None:
        return

    log_path = Path(t["log"])
    log_f = open(log_path, "w")
    log_f.write(f"=== task {t['id']} (immediate) ===\n")
    if t.get("desc"):
        log_f.write(f"desc: {t['desc']}\n")
    log_f.write(f"cmd: {' '.join(shlex.quote(c) for c in t['cmd'])}\n")
    log_f.write(f"cwd: {t['cwd']}\n")
    log_f.write(f"submitted: {t['submitted_at']}\n")
    log_f.write(f"started:   {now_iso()}\n")
    log_f.write("=== output ===\n")
    log_f.flush()

    try:
        proc = subprocess.Popen(
            t["cmd"],
            cwd=t["cwd"] if os.path.isdir(t["cwd"]) else None,
            stdout=log_f,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        log_f.write(f"\n=== failed to start: {e} ===\n")
        log_f.close()
        with locked():
            tasks = load_tasks()
            for x in tasks:
                if x["id"] == tid:
                    x["status"] = "failed"
                    x["finished_at"] = now_iso()
                    x["exit_code"] = -1
                    purge_dataset_modules(x)
            save_tasks(tasks)
        return

    with locked():
        tasks = load_tasks()
        for x in tasks:
            if x["id"] == tid:
                x["status"] = "running"
                x["pid"] = proc.pid
                x["started_at"] = now_iso()
        save_tasks(tasks)

    ret = proc.wait()
    log_f.write(f"\n=== finished: {now_iso()} exit={ret} ===\n")
    log_f.close()
    with locked():
        tasks = load_tasks()
        for x in tasks:
            if x["id"] == tid:
                if x["status"] == "running":
                    x["status"] = "done" if ret == 0 else "failed"
                x["exit_code"] = ret
                x["finished_at"] = now_iso()
                purge_dataset_modules(x)
        save_tasks(tasks)


# ---------- daemon ----------

def daemon_alive():
    if not DAEMON_PID.exists():
        return False
    try:
        return pid_alive(int(DAEMON_PID.read_text().strip()))
    except (ValueError, FileNotFoundError):
        return False


def ensure_daemon():
    if daemon_alive():
        return
    DAEMON_PID.unlink(missing_ok=True)
    log_f = open(DAEMON_LOG, "a")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--daemon"],
        stdin=subprocess.DEVNULL,
        stdout=log_f,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
    )
    log_f.close()
    # give it a moment to write its pid
    for _ in range(20):
        if daemon_alive():
            return
        time.sleep(0.1)


_stop_requested = False


def _handle_stop(signum, frame):
    global _stop_requested
    _stop_requested = True


def run_daemon():
    init()
    # single-instance guard via the lock file (separate from queue lock)
    guard_path = ROOT / "daemon.lock"
    guard = open(guard_path, "w")
    try:
        fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return  # another daemon is running

    DAEMON_PID.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, _handle_stop)
    signal.signal(signal.SIGINT, _handle_stop)

    # Recover tasks from a previous daemon. If the process is still alive, keep
    # it as running and count its GPU slot as busy for future scheduling.
    with locked():
        tasks = load_tasks()
        changed = reap_dead_running_tasks(tasks)
        if changed:
            save_tasks(tasks)
        # Sweep leaked dataset snapshot modules from crashed runs: any task not
        # pending/running no longer needs its working copies under data/.
        for t in tasks:
            if t["status"] not in ("pending", "running"):
                purge_dataset_modules(t)

    current = []  # list of dicts: {id, proc, log_f}
    last_active = time.time()

    print(f"[{now_iso()}] daemon started pid={os.getpid()}", flush=True)

    try:
        while not _stop_requested:
            # check current processes
            for item in list(current):
                ret = item["proc"].poll()
                if ret is not None:
                    item["log_f"].write(
                        f"\n=== finished: {now_iso()} exit={ret} ===\n"
                    )
                    item["log_f"].close()
                    with locked():
                        tasks = load_tasks()
                        for t in tasks:
                            if t["id"] == item["id"]:
                                if t["status"] == "running":
                                    t["status"] = "done" if ret == 0 else "failed"
                                t["exit_code"] = ret
                                t["finished_at"] = now_iso()
                                purge_dataset_modules(t)
                        save_tasks(tasks)
                    print(f"[{now_iso()}] task {item['id']} finished exit={ret}", flush=True)
                    current.remove(item)
                    last_active = time.time()

            # pick next tasks up to current parallel limit
            cfg = load_config()
            while cfg.get("worker_dispatch") or len(current) < cfg["parallel"]:
                with locked():
                    tasks = load_tasks()
                    if reap_dead_running_tasks(
                        tasks, managed_ids=[item["id"] for item in current]
                    ):
                        save_tasks(tasks)
                    next_task = next((t for t in tasks if t["status"] == "pending"), None)
                if next_task is None:
                    break

                current_ids = {item["id"] for item in current}
                busy_slots = []
                for t in tasks:
                    if t.get("status") == "running" and (
                        t.get("id") in current_ids or pid_alive(t.get("pid") or 0)
                    ):
                        busy_slots.extend(task_gpu_slots(t))
                launch_cmd, assignment = build_launch_command(
                    next_task, cfg, busy_slots=busy_slots
                )
                if launch_cmd is None:
                    print(
                        f"[{now_iso()}] no idle GPU for task {next_task['id']} "
                        f"(need {next_task.get('gpu_count', 1)} GPU(s) on one worker, "
                        f"util<{cfg['gpu_util_max']} free>{cfg['gpu_free_min']}%)",
                        flush=True,
                    )
                    break

                log_path = Path(next_task["log"])
                log_f = open(log_path, "w")
                log_f.write(f"=== task {next_task['id']} ===\n")
                if next_task.get("desc"):
                    log_f.write(f"desc: {next_task['desc']}\n")
                log_f.write(f"cmd: {' '.join(shlex.quote(c) for c in next_task['cmd'])}\n")
                log_f.write(f"cwd: {next_task['cwd']}\n")
                if assignment:
                    free_pct = assignment.get("gpu_free_percent")
                    free_s = "-" if free_pct is None else f"{free_pct:.1f}%"
                    log_f.write(
                        "worker: "
                        f"{assignment.get('worker_id')} "
                        f"host={assignment.get('worker_host') or '-'} "
                        f"gpu_index={assignment.get('gpu_index') or '-'} "
                        f"gpu={assignment.get('gpu_uuid') or '-'} "
                        f"util={assignment.get('gpu_util')} "
                        f"free={free_s} "
                        f"launcher={assignment.get('launcher') or '-'} "
                        f"ssh_target={assignment.get('ssh_target') or '-'}\n"
                    )
                log_f.write(f"submitted: {next_task['submitted_at']}\n")
                log_f.write(f"started:   {now_iso()}\n")
                log_f.write("=== output ===\n")
                log_f.flush()
                try:
                    proc = subprocess.Popen(
                        launch_cmd,
                        cwd=None if assignment else (
                            next_task["cwd"] if os.path.isdir(next_task["cwd"]) else None
                        ),
                        stdout=log_f,
                        stderr=subprocess.STDOUT,
                        stdin=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                except Exception as e:
                    log_f.write(f"\n=== failed to start: {e} ===\n")
                    log_f.close()
                    with locked():
                        tasks = load_tasks()
                        for t in tasks:
                            if t["id"] == next_task["id"]:
                                t["status"] = "failed"
                                t["finished_at"] = now_iso()
                                t["exit_code"] = -1
                                purge_dataset_modules(t)
                        save_tasks(tasks)
                    next_task = None
                else:
                    with locked():
                        tasks = load_tasks()
                        for t in tasks:
                            if t["id"] == next_task["id"]:
                                t["status"] = "running"
                                t["pid"] = proc.pid
                                t["started_at"] = now_iso()
                                if assignment:
                                    t.update(assignment)
                        save_tasks(tasks)
                    current.append(
                        {
                            "id": next_task["id"],
                            "proc": proc,
                            "log_f": log_f,
                            "worker_id": assignment.get("worker_id") if assignment else None,
                            "gpu_slot": assignment.get("gpu_slot") if assignment else None,
                            "gpu_slots": assignment.get("gpu_slots") if assignment else None,
                        }
                    )
                    where = f" worker={assignment['worker_id']} gpu={assignment['gpu_index']}" if assignment else ""
                    print(f"[{now_iso()}] task {next_task['id']} started pid={proc.pid}{where}", flush=True)
                    last_active = time.time()
                if next_task is None:
                    break

            # check for killed-on-running: if user marked status killed, kill process group
            if current:
                with locked():
                    tasks = load_tasks()
                    killed_ids = {t["id"] for t in tasks if t["status"] == "killed"}
                    for item in current:
                        if item["id"] in killed_ids:
                            try:
                                os.killpg(os.getpgid(item["proc"].pid), signal.SIGTERM)
                            except ProcessLookupError:
                                pass

            # idle exit
            with locked():
                has_pending = any(t["status"] == "pending" for t in load_tasks())
            if not current and not has_pending and time.time() - last_active > IDLE_EXIT_SECONDS:
                print(f"[{now_iso()}] idle, exiting", flush=True)
                break

            time.sleep(1)
    finally:
        # if we are stopping while a task runs, leave it running but record state
        for item in current:
            ret = item["proc"].poll()
            if ret is None:
                # detach: leave task as running, daemon will pick up status on next run via orphan logic
                item["log_f"].write(
                    f"\n=== daemon stopping at {now_iso()}, task continues in background ===\n"
                )
            item["log_f"].close()
        DAEMON_PID.unlink(missing_ok=True)
        print(f"[{now_iso()}] daemon exit", flush=True)


