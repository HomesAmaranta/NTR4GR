def cmd_stop_daemon(_argv):
    if not DAEMON_PID.exists():
        print("daemon not running")
        return
    try:
        pid = int(DAEMON_PID.read_text().strip())
    except (ValueError, FileNotFoundError):
        print("daemon pid file invalid")
        return
