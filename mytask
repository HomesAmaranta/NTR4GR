def _parse_id_range(spec):
    if "-" in spec:
        a, b = spec.split("-", 1)
        lo, hi = int(a), int(b)
        if lo > hi:
            lo, hi = hi, lo
        return list(range(lo, hi + 1))
    return [int(spec)]


def cmd_kill(argv):
    if not argv:
        print("mytask: kill requires a task id or range (e.g. 3 or 3-7)", file=sys.stderr)
        sys.exit(1)
    try:
        tids = _parse_id_range(argv[0])
    except ValueError:
        print(f"mytask: invalid id/range '{argv[0]}'", file=sys.stderr)
        sys.exit(1)
    with locked():
        tasks = load_tasks()
        by_id = {x["id"]: x for x in tasks}
        changed = False
        for tid in tids:
            t = by_id.get(tid)
            if not t:
                print(f"task {tid}: no such task")
                continue
            if t["status"] == "pending":
                t["status"] = "cancelled"
                t["finished_at"] = now_iso()
                purge_dataset_modules(t)
                changed = True
                print(f"task {tid}: cancelled (was pending)")
                continue
            if t["status"] == "running" and t["pid"]:
                try:
                    pgid = os.getpgid(t["pid"])
                    os.killpg(pgid, signal.SIGTERM)
                    t["status"] = "killed"
                    t["finished_at"] = now_iso()
                    t["exit_code"] = -signal.SIGTERM
                    purge_dataset_modules(t)
                    changed = True
                    print(f"task {tid}: sent SIGTERM to pgid {pgid}")
                except ProcessLookupError:
                    t["status"] = "killed"
                    t["finished_at"] = now_iso()
                    t["exit_code"] = -1
                    changed = True
                    print(f"task {tid}: process already gone, marked killed")
                continue
            print(f"task {tid}: status is {t['status']}, nothing to kill")
        if changed:
            save_tasks(tasks)


def cmd_parallel(argv):
    with locked():
        cfg = load_config()
        if not argv:
            scope = "per GPU worker" if cfg.get("worker_dispatch") else "total local"
            print(f"parallel: {cfg['parallel']} ({scope})")
            return
        try:
            n = int(argv[0])
        except ValueError:
            print(f"mytask: invalid parallel value '{argv[0]}'", file=sys.stderr)
            sys.exit(1)
        if n < 1:
            print("mytask: parallel must be >= 1", file=sys.stderr)
            sys.exit(1)
        old = cfg["parallel"]
        cfg["parallel"] = n
        save_config(cfg)
    ensure_daemon()
    scope = "per GPU worker" if cfg.get("worker_dispatch") else "total local"
    print(f"parallel: {old} -> {n} ({scope})")


