def _bucket_name(tid):
    """Range-named bucket grouping every 1000 task ids: 0-999, 1000-1999, ..."""
    lo = (tid // 1000) * 1000
    return f"{lo}-{lo + 999}"


def task_cache_dir(tid):
    """Per-task cache dir holding the snapshotted sh + yaml + dataset copies."""
    return SCRIPTS_DIR / _bucket_name(tid) / str(tid)


def purge_dataset_modules(t):
    """Delete the runtime dataset snapshot modules placed under the project's
    data/ package. Called when a task reaches a terminal state so the working
    copies don't pollute the training project. Archival copies in the task dir
    are kept."""
    for p in t.get("cached_dataset_modules") or []:
        try:
            Path(p).unlink()
        except (FileNotFoundError, OSError):
            pass


def cleanup_cached_script(t):
    """Best-effort full purge of a task's cached artifacts (dead code today;
    kept in sync with the new layout). Removes the working dataset modules and
    the whole per-task cache dir."""
    purge_dataset_modules(t)
    p = t.get("cached_script")
    tdir = Path(p).parent if p else None
    for p in [t.get("cached_script"), *(t.get("cached_yamls") or []),
              *(t.get("cached_datasets") or [])]:
